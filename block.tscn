[sub_resource type="GDScript" id="GDScript_cb14l"]
resource_name = "hover"
script/source = "extends Panel
@onready var block := owner as Block


func _ready():
	block.mouse_exited.connect(hide)
	block.mouse_entered.connect(func(): if block.state==Block.State.IDLE: show())
	hide()
"

[sub_resource type="GDScript" id="GDScript_5npld"]
resource_name = "btn_fan_test"
script/source = "extends Button
@onready var block := owner as Block


func _ready():
	pressed.connect(func():
		block.apply_result(Matchable.Result.new(true,[],true,Powerup.Type.FAN))
	)
"

[sub_resource type="GDScript" id="GDScript_5d32t"]
resource_name = "dot"
script/source = "extends Line2D


func place(where: Vector2):
	show()
	var tween := create_tween()
	tween.tween_property(self, 'modulate:a', 0, 1.5).from(1)
	tween.tween_callback(queue_free)
	global_position = where
	return self
"

[sub_resource type="Curve" id="Curve_5d32t"]
