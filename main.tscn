[sub_resource type="GDScript" id="GDScript_uoiob"]
resource_name = "minimap"
script/source = "extends TileMapLayer

var tiles: Dictionary[Vector2i, Tile]
var labels: Dictionary[Vector2i, Label]


func _ready() -> void:
	set_process(false)


func setup(_tiles: Dictionary):
	tiles = _tiles
	for coord: Vector2i in tiles:
		var label := Label.new()
		label.position = map_to_local(coord)
		label.text = 'init'
		add_child(label)
		labels[coord] = label
	set_process(true)


var timer: float
func _process(delta: float) -> void:
	timer += delta
	if timer < .5: return
	timer = 0.0
	for coord: Vector2i in tiles:
		if not tiles[coord]:
			labels[coord].text = ''
		else:
			labels[coord].text = tiles[coord].label.text
			if tiles[coord] is Matchable:
				labels[coord].modulate = colors[tiles[coord].type]
			else:
				labels[coord].modulate = Color.WHITE


var colors := [
	Color(0.0, 1.0, 0.0, 1.0),
	Color(0.384, 0.749, 1.0, 1.0),
	Color(1.0, 0.451, 0.0, 1.0),
	Color(1.0, 0.0, 1.0, 1.0),
	Color(0.89, 0.922, 0.0, 1.0),
	]
"

[sub_resource type="GDScript" id="GDScript_vt7at"]
