[sub_resource type="GDScript" id="GDScript_0xm2m"]
resource_name = "TestButton"
script/source = "extends Button

@export var board: Board


func _ready() -> void:
	pressed.connect(delete_random)


func delete_random():
	var holes: Array[Vector2i]
	var batch := Batch.new()
	var type := Matchable.Type.values().pick_random() as Matchable.Type
	for coord: Vector2i in board.tiles:
		var tile: Tile = board.tiles.get(coord)
		if tile and tile.is_idle and tile is Matchable and tile.type==type:
			holes.append(coord)
			tile.delete()
			batch.add_signal(tile.deleted)
	await batch.finished
	board.cascade_many(holes)

"

[sub_resource type="GDScript" id="GDScript_wuxof"]
resource_name = "floor"
script/source = "extends StaticBody2D

@export var board: Board


func _ready() -> void:
	position = board.map_to_local(board.get_used_rect().end) \\
				- board.tile_set.tile_size / 2.0
"

[sub_resource type="WorldBoundaryShape2D" id="WorldBoundaryShape2D_wuxof"]

[sub_resource type="GDScript" id="GDScript_pxnx5"]
resource_name = "camera"
script/source = "extends Camera2D

@export var board: Board


func _ready() -> void:
	await get_tree().process_frame
	var view_height := get_viewport_rect().size.y
	var rect := board.get_used_rect()
	var target_height := rect.size.y * board.tile_set.tile_size.y
	prints('zooming camera from', view_height, 'to', target_height)
	zoom = Vector2.ONE * (view_height / target_height)
	position = rect.size/2.0 * Vector2(board.tile_set.tile_size)
	position.x += 222



"

[sub_resource type="TileSet" id="TileSet_0xm2m"]
