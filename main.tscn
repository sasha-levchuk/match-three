[sub_resource type="GDScript" id="GDScript_1bvp3"]
resource_name = "camera"
script/source = "extends Camera2D
const SHAKE_POWER := 22
const SHAKE_PERIOD := 0.05
@onready var tween: Tween
@onready var orig_pos := position


func _ready():
	if Engine.is_embedded_in_editor():
		zoom = Vector2.ONE * 0.3
		Board.ZOOM = zoom
	#Game.tnt_exploded.connect(_on_tnt_exploded)


func _on_tnt_exploded():
	if not tween or not tween.is_running():
		tween = create_tween()
	for i in 3:
		var new_pos := position + Vector2((randf()-0.5)*SHAKE_POWER, (randf()-0.5*SHAKE_POWER))
		tween.tween_property(self, 'position', new_pos, SHAKE_PERIOD).set_trans(Tween.TRANS_CUBIC)
		tween.tween_property(self, 'position', orig_pos, SHAKE_PERIOD).set_trans(Tween.TRANS_CUBIC)
"

