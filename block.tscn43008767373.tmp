[sub_resource type="GDScript" id="GDScript_xfwl5"]
resource_name = "sprite"
script/source = "extends Sprite2D

func _on_click_pressed(event: InputEventMouseButton):
	prints('pressed', event)


func _on_mouse_motion(event: InputEventMouseMotion):
	position += event.relative


func _on_click_released(event: InputEventMouseButton):
	place_back()
	prints('released', event)


func place_back():
	var tween := create_tween()
	tween.tween_property(self, 'position', Vector2.ZERO, 0.2)
	return tween.finished
"

