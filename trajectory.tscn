[sub_resource type="GDScript" id="GDScript_272bh"]
resource_name = "path2d"
script/source = "extends Path2D
@export var follow: PathFollow2D
@export var rem_trans: RemoteTransform2D


func animate_projectile(thing: Node2D):
	thing.z_index = 99
	var pos := thing.global_position
	rem_trans.remote_path = thing.get_path()
	curve.set_point_position(0, pos)
	curve.set_point_out(0, Vector2(555,555)-pos)
	follow.rotation = thing.rotation
	follow.progress_ratio = 0.0
	var tween := create_tween()
	tween.set_parallel(true)
	var time := 1.0
	tween.tween_property(follow, 'rotation', TAU * ((randi()%2)*2-1), time)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tween.tween_property(follow, 'progress_ratio', 1.0, time)\\
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(thing, 'scale', 0.2 * Vector2.ONE, time)\\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	tween.tween_property(thing, 'modulate:a', 0.0, time)\\
		.set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_IN)
	tween.set_parallel(false)
	tween.tween_callback(thing.queue_free)
	tween.tween_callback(queue_free)
	return tween.finished
"

