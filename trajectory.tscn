[sub_resource type="GDScript" id="GDScript_272bh"]
resource_name = "path2d"
script/source = "extends Path2D
@export var follow: PathFollow2D
@export var rem_trans: RemoteTransform2D
@export var line: Line2D


func _input(event: InputEvent):
	if event is InputEventMouseButton:
		if event.is_pressed():
			prints(event, 'pressed')
		else:
			prints(event, 'released')


func animate(thing: Node2D, target_node: Node2D):
	thing.z_index = 99
	var start := thing.global_position
	var end := target_node.global_position
	curve.set_point_position(0, start)
	curve.set_point_position(1, end)
	var middle := (end-start)/2
	curve.set_point_out(0, middle.rotated((randf()-.5)*TAU))
	curve.set_point_in(1, -middle)
	line.points = curve.get_baked_points()
	follow.rotation = thing.rotation
	rem_trans.remote_path = thing.get_path()
	var time := 1.0
	var tween := create_tween()
	tween.tween_property(thing, 'scale', Vector2.ONE * 1.2, time/3)
	tween.tween_property(thing, 'scale', Vector2.ONE, time/3*2)\\
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	tween = create_tween().set_parallel(true)
	var rot := TAU * randf_range(1, 2) * signf(randf()-.5)
	tween.tween_property(follow, 'rotation', rot , time)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tween.tween_property(follow, 'progress_ratio', 1.0, time)\\
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	#tween.tween_property(thing, 'scale', 0.5 * Vector2.ONE, time)\\
		#.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	#tween.tween_property(thing, 'modulate:a', 0.5, time)\\
		#.set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_IN)
	tween.set_parallel(false)
	tween.tween_callback(thing.queue_free)
	tween.tween_callback(queue_free)
	return tween.finished
"

