"

[sub_resource type="GDScript" id="GDScript_c4ttu"]
script/source = "extends Panel


func _ready():
	Event.score_updated.connect(func():
		if Game.crystals==0: 
			show()
	)
	Event.reset_requested.connect(hide)
"

