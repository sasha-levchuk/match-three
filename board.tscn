[sub_resource type="GDScript" id="GDScript_8l818"]
resource_name = "camera"
script/source = "extends Camera2D
@export var base_size := Vector2(972, 972)


func _ready():
	update_zoom()
	get_viewport().size_changed.connect(update_zoom)


func update_zoom():
	var winsize := get_viewport_rect().size
	var axis := winsize.min_axis_index()
	zoom = winsize[axis] * Vector2.ONE / base_size
	prints('update zoom', winsize, zoom)
	var is_portrait := get_viewport_rect().size.max_axis_index() as bool
	prints('is portrait', is_portrait)
"

[sub_resource type="GDScript" id="GDScript_rq8yp"]
script/source = "extends MarginContainer


func _ready():
	if get_viewport_rect().size.min_axis_index() as bool:
		position = %UIAnchorLandscape.position
"

[sub_resource type="GDScript" id="GDScript_mgc1s"]
script/source = "extends BoxContainer


func _ready():
	vertical = get_viewport_rect().size.min_axis_index() as bool
"

[sub_resource type="GDScript" id="GDScript_tngv2"]
script/source = "extends Label


func _ready():
